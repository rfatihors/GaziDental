# ---- gummy_smile_v4 ----
# Large / generated artefacts never enter git
*.pt
*.pth
*.onnx
*.zip
*.tar
*.tar.gz
runs/
GORUNTULER/
notebooks/**/outputs/
# outputs/: only small reports (md/csv/json), figures (png < 2 MB) and the prediction
# artefacts that come back from the training workstation are versioned.
outputs/**
!outputs/**/
!outputs/**/*.md
!outputs/**/*.csv
!outputs/**/*.json
!outputs/**/*.png
!outputs/**/*.yaml
outputs/**/runs/
outputs/**/*.pt
# Generated YOLO dataset (symlinks + labels) is rebuilt from the manifest
data/yolo_dataset/
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/
# OS / editor
.DS_Store
.idea/
.vscode/
